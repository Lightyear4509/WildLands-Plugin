{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ggwpwildlands:caiman",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/caiman"
      },
      "geometry": {
        "default": "geometry.ggwpwildlands.caiman"
      },
      "animations": {
        "idle": "animation.ggwpwildlands.caiman.idle",
        "walk": "animation.ggwpwildlands.caiman.walk",
        "stalk": "animation.ggwpwildlands.caiman.stalk",
        "warning": "animation.ggwpwildlands.caiman.warning",
        "attack": "animation.ggwpwildlands.caiman.attack",
        "death": "animation.ggwpwildlands.caiman.death",
        "swim": "animation.ggwpwildlands.caiman.swim"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.modified_move_speed > 0.01 && !query.is_in_water"
          },
          {
            "stalk": "query.property('ggwpwildlands:phase') == 1"
          },
          {
            "warning": "query.property('ggwpwildlands:phase') == 2"
          },
          {
            "attack": "query.property('ggwpwildlands:phase') == 3"
          },
          {
            "death": "!query.is_alive"
          },
          {
            "swim": "query.is_in_water"
          }
        ]
      },
      "render_controllers": [
        "controller.render.ggwpwildlands.caiman"
      ]
    }
  }
}
